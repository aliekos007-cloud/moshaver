# ==================================================
# تنظیمات محیطی پروژه «مشاور»
# این فایل را به .env کپی کنید و مقادیر را پر کنید
# ==================================================


# ===== امنیت (اجباری در Production) =====
SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost


# ===== دیتابیس =====
# برای توسعه: USE_POSTGRES=False (از SQLite استفاده می‌شود)
# برای Production: USE_POSTGRES=True
USE_POSTGRES=False

DB_NAME=moshaver
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# ===== امنیت Production (فقط وقتی DEBUG=False) =====
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True